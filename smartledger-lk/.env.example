# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/smartledger-lk

# JWT Secret for session tokens (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI / Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# PayHere Sri Lanka Payment Gateway Configuration
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret

# App URL (used for PayHere callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
